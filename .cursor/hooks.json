{
  "version": 1,
  "hooks": {
    "preCompact": [
      {
        "command": "python3 .cursor/hooks/pre_compact.py"
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/post_tool_use.py"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python3 .cursor/hooks/post_tool_use.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/after_file_edit.py"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/stop.py",
        "loop_limit": 1
      }
    ]
  }
}
